  System boundaryworker 
  
  /*
   * boundaryworker_guimap.qak
   * 
   * Percorre il perimetro mostrando anche la 'mappa mentale'
   */
  
  
  Dispatch move : move(M) "M = l|r|a|d|h mosse aril ok"

  Request cmd     : cmd(MOVE,T) "MOVE = w|s mosse aril asynch"
  Reply cmddone   : cmddone(R) for cmd
  Reply cmdfailed : cmdfailed(T,CAUSE) for cmd

  Request step     : step(TIME)
  Reply stepdone   : stepdone(V) for step 
  Reply stepfailed : stepfailed(DURATION, CAUSE) for step
   
  Context ctxboundary       ip [host="localhost"  port=8120]
  Context ctxrobotservice26 ip [host="127.0.0.1"  port=8125]
  
  ExternalQActor robotactor context ctxrobotservice26
  
  QActor boundaryworker context ctxboundary 
   		withobj room using "location.RoomMap(5,6)"
        withobj gui using "adapters.AdapterGui.create(\"tf25map.txt\")"{   
                  	
    [#
    	val NR = room.getNr()
    	val NC = room.getNc()
    	val StepTime = 345
    	var CURX = 0
    	var CURY = 0
    	var NLAP = 0
    #]
    State s0 initial{
    	println("$name | starts with map NR=$NR NC=$NC" ) color magenta
    	println("$room" ) color magenta
     	[# clearlog("./logs/ddrboundary.log") 	//vedi src/main/resources/logback.xml #]
    	[# logger.info(  "${currentState.stateName}: starts"  ) #]
    	
  	 	[# room.setRobotAtHome() #]
  	 	[# gui.showTheRoom()     #]
   	 	[# gui.displayOnGui(CURX,CURY,`it.unibo.kactor`.GuiColors.SUD) #] 
  	 	
    } 
    Goto doboundary
   
   State doboundary{
   	 println("$name | doboundary $NLAP") color blue
   	 request robotactor -m step : step( $StepTime ) 
   	 delay 500
    }
    Transition t0 
    	whenReply stepdone   -> stepok
    	whenReply stepfailed -> hitwall
    
    State stepok{
    	[# logger.info(  "${currentState.stateName}: step ddone"  ) #]
    	[# gui.displayOnGui(CURY,CURX,`it.unibo.kactor`.GuiColors.ACQUA) #]
   	 	[# 	room.doStep()  		       //passo mentale
   	    	CURX = room.getPosX() 
   	 		CURY = room.getPosY()
   	  	#]
   	  	[# room.showMap() #]
    	//[# gui.displayOnGui(CURY,CURX,`it.unibo.kactor`.GuiColors.SUD) #] 	
    	[# gui.showDir(CURX,CURY,room.getDir() ) #]
    }
    Goto doboundary
    
    State hitwall{
    	[# var TDONE = "0" #]
    	//println("$name | hitwall ") color magenta
    	onMsg( stepfailed : stepfailed(T,CAUSE) ){
    		[#  TDONE = payloadArg(0) #]
    		println("$name | hit wall after: $TDONE") color magenta
    	}
    	
    	[# logger.info(  "${currentState.stateName}: step failed $NLAP"  ) #]
    	[# room.showMap() #]
    	
    	[# gui.displayOnGui(CURY,CURX,`it.unibo.kactor`.GuiColors.ACQUA) #]
    	forward robotactor -m move : move(l)
   	 	[# room.turnLeft()  		       //passo mentale
     	   gui.showDir(CURX,CURY,room.getDir() ) 
   	  	#]    	
    	
    	[# NLAP = NLAP + 1 #]
    	
    	
    	//[# System.exit(0) #]
    }
    Goto doboundary if [# NLAP < 4 #] else end
    
    State end{
    	delay 1000
    	[# System.exit(0) #]
    }
    
 
  } 
    
 

 