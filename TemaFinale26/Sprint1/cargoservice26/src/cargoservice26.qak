System cargoservice26
	mqttBroker "127.0.0.1" : 1883   eventTopic "cargoservice26in"
/*
 * WARNING: con mosquitto in Docker, "localhost" puo' non ricevere i messaggi:
 *          usare l'IP reale del PC sia qui sia nei dispositivi.
 *
 * ============================================================
 *  cargoservice26.qak  -  modello (QActor) del cargoservice  -  TemaFinale26
 *  SPRINT 1 = core (Sprint 0) + sensor dell'IOPort + timeout 30s.
 *
 *  Aggiunte rispetto allo Sprint 0:
 *    - Event containerInPlace : notifica LOGICA del sensor dell'IOPort
 *      (il sensor reale - sonar - rileva la presenza quando D < DFREE/2 per ~3s;
 *       il formato/trasporto fisico e' dettaglio di Progetto, qui astratto in un evento).
 *    - State waitContainer (engaged): dopo aver riservato lo slot, il sistema attende
 *      il container nell'area del sensor, con whenEvent / whenTime (firefly100.qak).
 *    - timeout 30s -> State disengage: libera lo slot, spegne il LED, torna available.
 *    - QActor iosensor e pushbutton: SIMULAZIONI per eseguire il modello senza hardware.
 *
 *  Contratto del cargorobot preso da robotsmart (robotsmart26usage/src/robotsmart26tf26.qak).
 * ============================================================
 */

/* ---- pushbutton -> cargoservice   (REQUISITO: request/reply) ---- */
Request loadrequest    : loadrequest(CALLER)   "CALLER don't care (stile del docente: arg sempre presente)"
Reply   answer         : answer(RESP)   for loadrequest   "RESP = reserved(SLOT)|retrylater|reject"

/* ---- sensor dell'IOPort -> cargoservice   (NOTIFICA logica; formato fisico = Progetto) ---- */
Event   containerInPlace : containerInPlace(WHERE)   "il container e' nell'area del sensor"

/* ---- cargoservice -> cargorobot   (contratto di robotsmart) ---- */
Request moverobot      : moverobot(TARGETX, TARGETY, STEPTIME)
Reply   moverobotdone  : moverobotok(ARG)                     for moverobot
Reply   moverobotfailed: moverobotfailed(PLANDONE, PLANTODO)  for moverobot

Context ctxcargo      ip [host="localhost" port=8030]
Context ctxrobotsmart ip [host="127.0.0.1" port=8020]

ExternalQActor robotsmart context ctxrobotsmart

QActor cargoservice context ctxcargo
        withobj hold    using "domain.Hold()"
        withobj display using "devices.DisplaySim()"
        withobj led     using "devices.LedSim()" {
   [# var Slot     = ""
      val StepTime = 345
   #]
   State s0 initial {
      println("$name | starts") color blue
      subscribe "cargoservice26in_out"   //per percepire containerInPlace emesso dall'iosensor via MQTT
                                         //(pattern: robotsmart26tf26.qak, subscribe "robotsmart26in_out")
      [# display.show("serviceworking") #]
   }
   Goto available

   State available {                                   //Service working
      println("$name | available (attende loadrequest)") color yellow
   }
   Transition t0
      whenRequest loadrequest -> evalRequest

   State evalRequest {
      onMsg( loadrequest : loadrequest(CALLER) ){
         [# Slot = "" #]
         if [# hold.ioportOccupied() #] {
            replyTo loadrequest with answer : answer(retrylater)
            [# display.show("retrylater") #]
         }
         if [# !hold.ioportOccupied() && hold.isFull() #] {
            replyTo loadrequest with answer : answer(reject)
            [# display.show("reject") #]
         }
         if [# !hold.ioportOccupied() && !hold.isFull() #] {
            [# Slot = hold.reserveFreeSlot() #]
            replyTo loadrequest with answer : answer(reserved($Slot))
            [# display.show("reserved " + Slot); led.blink(true) #]    //engaged
         }
      }
   }
   Goto waitContainer if [# Slot != "" #] else available

   //SPRINT1: engaged -> attesa del container nell'area del sensor (max 30s)
   State waitContainer {
      println("$name | engaged: attendo il container nell'area del sensor (timeout 30s)") color magenta
   }
   Transition t0
      whenTime   30000           -> disengage
      whenEvent containerInPlace -> goToIOPort

   //SPRINT1: timeout scaduto -> disengage (libera lo slot riservato, LED off)
   State disengage {
      [# hold.freeSlot(Slot); led.blink(false); display.show("disengaged"); Slot = "" #]
      println("$name | TIMEOUT: container non arrivato -> disengage, slot liberato") color red
   }
   Goto available

   State goToIOPort {                                  //HOME -> IOPort (presa astratta)
      println("$name | containerInPlace ricevuto -> cargorobot verso IOPort") color blue
      [# val IX = hold.ioportX(); val IY = hold.ioportY() #]
      request robotsmart -m moverobot : moverobot($IX, $IY, $StepTime)
   }
   Transition t0
      whenReply moverobotdone   -> carryToSlot5
      whenReply moverobotfailed -> robotFailure

   State carryToSlot5 {                                //IOPort -> slot5 (marcatura)
      [# val SX = hold.slotX("slot5"); val SY = hold.slotY("slot5") #]
      request robotsmart -m moverobot : moverobot($SX, $SY, $StepTime)
   }
   Transition t0
      whenReply moverobotdone   -> marking
      whenReply moverobotfailed -> robotFailure

   State marking {                                     //marker simulato nel core (Sprint succ.: evento markingDone)
      println("$name | marcatura in slot5 ...") color cyan
      delay 1000
   }
   Goto carryToReserved

   State carryToReserved {                             //slot5 -> slot riservato
      [# val SX = hold.slotX(Slot); val SY = hold.slotY(Slot) #]
      request robotsmart -m moverobot : moverobot($SX, $SY, $StepTime)
   }
   Transition t0
      whenReply moverobotdone   -> goHome
      whenReply moverobotfailed -> robotFailure

   State goHome {                                      //ritorno a HOME
      [# hold.confirmStored(Slot)
         val HX = hold.homeX(); val HY = hold.homeY() #]
      request robotsmart -m moverobot : moverobot($HX, $HY, $StepTime)
   }
   Transition t0
      whenReply moverobotdone   -> doneRequest
      whenReply moverobotfailed -> doneRequest         //container GIA' stoccato: HOME e' best-effort

   //SPRINT1: il cargorobot fallisce PRIMA dello stoccaggio -> slot liberato, servizio di nuovo disponibile
   State robotFailure {
      [# hold.freeSlot(Slot); led.blink(false); display.show("robotfailure"); Slot = "" #]
      println("$name | moverobotfailed: slot liberato, servizio disponibile") color red
   }
   Goto available

   State doneRequest {
      [# led.blink(false); display.show("holdstate") #]
      println("$name | richiesta completata: container in $Slot") color green
   }
   Goto available
}

/* =====================================================================
 *  SIMULAZIONI per eseguire il modello senza hardware (sostituibili dai
 *  dispositivi reali: il cargoservice dipende solo dall'informazione).
 * ===================================================================== */

//iosensor: SIMULA il sensor dell'IOPort (sorgente di notifiche).
//Il sensor reale (sonar) emette la notifica logica containerInPlace quando
//rileva il container (D < DFREE/2 per ~3s). Qui: dopo 5s (< 30s, il cliente
//porta il container) emette l'evento, per eseguire il cammino felice.
//Per provare il TIMEOUT: portare il delay a > 30000 (o non emettere).
QActor iosensor context ctxcargo {
   State s0 initial {
      println("$name | sensor IOPort attivo (simulato)") color cyan
      delay 5000
   }
   Goto detect
   State detect {
      println("$name | container rilevato -> emit containerInPlace") color cyan
      emit containerInPlace : containerInPlace(ioport)
   }
}

//pushbutton: SIMULA il pushbutton dell'IOPort: avvia la demo inviando una loadrequest.
QActor pushbutton context ctxcargo {
   State s0 initial {
      delay 1000
      println("$name | premuto -> loadrequest") color green
      request cargoservice -m loadrequest : loadrequest(pushbutton)
   }
   Transition t0
      whenReply answer -> showAnswer
   State showAnswer {
      onMsg( answer : answer(RESP) ){
         println("$name | risposta del cargoservice: ${payloadArg(0)}") color green
      }
   }
}
