System firefly100system
Event flash : flash(ID)
Context ctxfirefly100 ip [host="localhost" port=8022]
QActor fireflyManager context ctxfirefly100 {
State s0 initial {
println("$name | Creando 100 luciernas...") color blue
[# for (i in 1..100) { createActorFsmDynamic("firefly", "_$i", false) } #]
println("$name | 100 luciernas creadas!") color blue
}
}
QActor firefly context ctxfirefly100 dynamicOnly {
[# var shouldSync = false #]
State s0 initial {
[# val initialDelay = kotlin.random.Random.nextLong(0, 900) #]
println("$name | activa, fase: ${initialDelay}ms") color yellow
[# delay(initialDelay) #]
}
Goto charging
State charging { [# shouldSync = false #]  discardMsg Off }
Transition t0  whenTime 1000 -> doFlash  whenEvent flash -> perceiveFlash
State perceiveFlash { onMsg(flash:flash(ID)){ [# shouldSync = payloadArg(0) != name #] } }
Goto doFlash if [# shouldSync #] else charging
State doFlash { println("$name | FLASH!") color yellow  emit flash : flash($name)  discardMsg On }
Goto refractory
State refractory { delay 200  discardMsg Off }
Goto charging
}
